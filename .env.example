# Copy to .env.local. For the local stack, `npm run db:start` prints these values
# (API_URL, PUBLISHABLE_KEY, SECRET_KEY). For production, set them in Vercel.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_..., or the legacy anon key). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_..., or the legacy service_role key). Server only: never
# prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Signs the guest player cookie. Server only; 32+ random characters, e.g.
# `openssl rand -base64 32`. Changing it gives every guest a fresh identity.
PLAYER_COOKIE_SECRET=
